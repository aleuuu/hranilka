{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Хранилка",
  "mainBinaryName": "hranilka",
  "version": "0.1.0",
  "identifier": "ru.hranilka.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:engine && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Хранилка",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#0e0e0f"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Хранилка",
    "shortDescription": "Наводит порядок в фото и документах с помощью локальной модели",
    "resources": {
      "../engine/dist/hranilka-engine/": "engine/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
